
(rules PCB Modified_LMNC_VCO
  (snap_angle 
    fortyfive_degree
  )
  (autoroute_settings
    (fanout off)
    (autoroute on)
    (postroute on)
    (vias on)
    (via_costs 50)
    (plane_via_costs 5)
    (start_ripup_costs 100)
    (start_pass_no 10307)
    (layer_rule F.Cu
      (active on)
      (preferred_direction vertical)
      (preferred_direction_trace_costs 1.0)
      (against_preferred_direction_trace_costs 2.2)
    )
    (layer_rule B.Cu
      (active on)
      (preferred_direction horizontal)
      (preferred_direction_trace_costs 1.0)
      (against_preferred_direction_trace_costs 1.8)
    )
  )
  (rule
    (width 250.0)
    (clear 200.2)
    (clear 125.0 (type smd_to_turn_gap))
    (clear 50.0 (type smd_smd))
  )
  (padstack "Via[0-1]_800:400_um"
    (shape
      (circle F.Cu 800.0 0.0 0.0)
    )
    (shape
      (circle B.Cu 800.0 0.0 0.0)
    )
    (attach off)
  )
  (via 
    "Via[0-1]_800:400_um" "Via[0-1]_800:400_um" default
  )
  (via 
    "Via[0-1]_800:400_um-kicad_default" "Via[0-1]_800:400_um" "kicad_default"
  )
  (via_rule
    default "Via[0-1]_800:400_um"
  )
  (via_rule
    "kicad_default" "Via[0-1]_800:400_um-kicad_default"
  )
  (class default
    "unconnected-(A1-Pad1)" "unconnected-(A1-Pad17)" "unconnected-(A1-Pad2)" "unconnected-(A1-Pad18)" "unconnected-(A1-Pad3)" "Net-(A1-Pad19)" GND "unconnected-(A1-Pad20)"
    "Net-(A1-Pad5)" "unconnected-(A1-Pad21)" "Net-(A1-Pad6)" "Net-(A1-Pad22)" "Net-(A1-Pad7)" "Net-(A1-Pad23)" "Net-(A1-Pad8)" "Net-(A1-Pad24)"
    "Net-(A1-Pad9)" "unconnected-(A1-Pad25)" "Net-(A1-Pad10)" "unconnected-(A1-Pad26)" "Net-(A1-Pad11)" "unconnected-(A1-Pad27)" "Net-(A1-Pad12)" "unconnected-(A1-Pad28)"
    "unconnected-(A1-Pad13)" "unconnected-(A1-Pad14)" "Net-(A1-Pad30)" "unconnected-(A1-Pad15)" "unconnected-(A1-Pad16)" FMINPUT "Net-(C1-Pad2)" +12V
    "-12V" "Net-(C4-Pad1)" SYNCIN1 "Net-(C6-Pad1)" "Net-(C7-Pad1)" "Net-(C15-Pad1)" "Net-(D1-Pad2)" "Net-(D2-Pad2)"
    "Net-(D3-Pad2)" G F A B DP C D
    E TUNERPOWER "Net-(J1-Pad1)" 1voctin CVIN RAMPOUT TRIANGLEOUT SQUAREOUT
    PWMIN LINKCV 1v ref "Net-(R1-Pad2)" "Net-(R3-Pad2)" "Net-(R3-Pad1)" "Net-(R5-Pad1)"
    "Net-(R5-Pad2)" CVINPUTS "Net-(R8-Pad2)" VP "Net-(R10-Pad1)" "Net-(R11-Pad1)" "Net-(R11-Pad2)" "Net-(R12-Pad2)"
    "Net-(R13-Pad2)" "Net-(R14-Pad2)" VPWM "Net-(R19-Pad2)" "Net-(R20-Pad1)" "Net-(R23-Pad2)" "Net-(R24-Pad2)" "Net-(R26-Pad2)"
    "Net-(R42-Pad1)" "Net-(RV7-Pad1)" HighFtrack VSO VTO "unconnected-(J2-PadTN)" "unconnected-(J3-PadTN)" "unconnected-(J4-PadTN)"
    "unconnected-(J5-PadTN)" "unconnected-(J6-PadTN)" "unconnected-(J7-PadTN)" "unconnected-(J8-PadTN)" "unconnected-(J9-PadTN)" "Net-(U1-Pad3)" "Net-(R17-Pad1)" "Net-(R18-Pad1)"
    "unconnected-(U3-Pad9)"
    (clearance_class default)
    (via_rule default)
    (rule
      (width 250.0)
    )
    (circuit 
      (use_layer F.Cu B.Cu)
    )
  )
  (class "kicad_default"
    (clearance_class "kicad_default")
    (via_rule kicad_default)
    (rule
      (width 250.0)
    )
    (circuit 
      (use_layer F.Cu B.Cu)
    )
  )
)